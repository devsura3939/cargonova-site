# ── CargoNova Logistics — environment variables ──────────────
# Copy this file to .env.local and fill in real values.
# Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap, and OG tags)
NEXT_PUBLIC_SITE_URL=https://cargonova.example.com

# PostgreSQL connection string (used once Prisma is wired up)
DATABASE_URL=postgresql://user:password@localhost:5432/cargonova

# Resend API key (transactional email for quote confirmations)
RESEND_API_KEY=

# Mapbox token (future: real geographic map behind CoverageMap/NetworkMap)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Analytics provider IDs (optional — leave empty to keep events no-op)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Rate limiting / bot protection (future)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
